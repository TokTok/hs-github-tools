#!/usr/bin/env bash

set -eu

REMOTE=""
BRANCH="${1-$(git rev-parse --abbrev-ref HEAD)}"

if (echo "$BRANCH" | grep ':' >/dev/null); then
  REMOTE="$(echo "$BRANCH" | grep -o '^[^:]*')"
  BRANCH="$(echo "$BRANCH" | grep -o '[^:]*$')"
  REMOTE="$(git remote -v | grep -i ":$REMOTE/.* (push)" | grep -o '^\S*')"
fi

if [ -n "$REMOTE" ] && ! (git branch | grep "^..$BRANCH\$" >/dev/null); then
  git checkout --track "$REMOTE/$BRANCH"
else
  git checkout "$BRANCH"
fi

# The remote the branch came from, before "git branch -d" forgets it.
REMOTE="$(git config "branch.$BRANCH.remote" || echo origin)"

git push upstream "$BRANCH:master"
git sync
git branch -d "$BRANCH"

# Someone else's branch is theirs to delete.
case "$REMOTE" in
  origin | upstream)
    sleep 2
    git push "$REMOTE" ":$BRANCH"
    ;;
  *)
    echo "Leaving $BRANCH on $REMOTE"
    ;;
esac
